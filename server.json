    {
      "id": "1494779018111746188",
      "name": "Community",
      "access": "open",
      "channels": [
        {"id": "1494779609131258048", "name": "gen-chat", "topic": "General chat about OpenDrone and FPV."},
        {"id": "1494781139980779682", "name": "introduce-yourself", "topic": "Say hi: what you fly, what you build and what brought you here."},
        {"name": "flying", "type": "text", "topic": "FPV talk: gear, spots, tunes, videos. Anything that flies."},
        {"name": "off-topic", "type": "text", "topic": "Everything that is not about flying or OpenDrone."},
        {"id": "1494782854117326969", "name": "builds", "topic": "Show your build: photos, the parts list and what you fly it for. Replies go in a thread on the post."},
        {"id": "1494033189532860707", "name": "proposals", "topic": "Propose a product or a change to one: a paragraph of what and why. Discussion goes in a thread on the post."}
      ]
    },
    {
      "id": "1497547320131190864",
      "name": "Support",
      "access": "open",
      "channels": [
        {
          "name": "help",
          "type": "forum",
          "topic": "One post per problem. Say which product and revision, the firmware and its version (for example Betaflight 4.5.1), what you expected, what happened and what you already tried. Add photos, a diff or a log when you can.\nOrders, payment, shipping, warranty or anything private: open a ticket at https://opendrone.be/support instead.\nTag the product and question or bug; add solved when it is fixed.",
          "forum": {
            "layout": "list",
            "sort": "activity",
            "default_reaction": "👍",
            "require_tag": true,
            "tags": [
              {"name": "Flight controller"},
              {"name": "ESC"},
              {"name": "Receiver"},
              {"name": "Video"},
              {"name": "Remote ID / GPS"},
              {"name": "Frame"},
              {"name": "Power"},
              {"name": "KiCad library"},
              {"name": "Firmware"},
              {"name": "Web and tools"},
              {"name": "question", "emoji": "❓"},
              {"name": "bug", "emoji": "🐛"},
              {"name": "solved", "emoji": "✅"}
            ]
          }
        }
      ]
    },
    {
      "name": "Development",
      "access": "open",
      "channels": [
        {
          "name": "git-feed",
