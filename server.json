      "channels": [
        {
          "name": "help",
          "type": "forum",
          "topic": "One post per problem. Say which product and revision, the firmware and its version (for example Betaflight 4.5.1), what you expected, what happened and what you already tried. Add photos, a diff or a log when you can.\nTag the product and question or bug; add solved when it is fixed.",
          "forum": {
            "layout": "list",
            "sort": "activity",
            "require_tag": true,
            "tags": [
              {"name": "Flight controller"},
              {"name": "ESC"},
              {"name": "Receiver"},
              {"name": "Video"},
              {"name": "Remote ID / GPS"},
              {"name": "Frame"},
              {"name": "Power"},
              {"name": "KiCad library"},
              {"name": "Firmware"},
              {"name": "Web and tools"},
              {"name": "question", "emoji": "❓"},
              {"name": "bug", "emoji": "🐛"},
              {"name": "solved", "emoji": "✅"}
