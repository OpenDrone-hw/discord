        {"id": "1494758332903456969", "name": "rx", "topic": "Receivers: OpenRX, OpenRX-Lite, OpenRX-Lite-UFL, OpenRX-Mono and OpenRX-Gemini hardware. One thread per pull request."},
        {"id": "1494758396577058900", "name": "vtx", "topic": "Analog video transmitters: OpenVTX hardware. One thread per pull request."},
